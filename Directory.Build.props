<Project>
  <PropertyGroup>
    <!-- This is the develop/v2 branch line, so 18 builds against Umbraco CMS 18 (develop/v1 uses 17). See
         src/Crumpled.VerifyOwnership/Composers/OpenApiRegistration.Umbraco{17,18}.cs and
         Directory.Packages.props for what this toggles. -->
    <UmbracoTargetMajor>18</UmbracoTargetMajor>
  </PropertyGroup>
</Project>
